<Window x:Class="TrayLens.FlyoutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TrayLens"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        Topmost="True" WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#E8F3F3F3"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#17000000"/>
        <SolidColorBrush x:Key="CardBg" Color="#9AFFFFFF"/>
        <SolidColorBrush x:Key="GraphBg" Color="#0F000000"/>
        <SolidColorBrush x:Key="TrackBg" Color="#16000000"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E4000000"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A000000"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#73000000"/>
        <SolidColorBrush x:Key="AccentDown" Color="#FF10846A"/>
        <SolidColorBrush x:Key="AccentUp" Color="#FF1C5FB8"/>
        <SolidColorBrush x:Key="BattColor" Color="#FF9A5A00"/>
        <SolidColorBrush x:Key="BattLow" Color="#FFB41E28"/>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#20000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Shell" BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}"
            CornerRadius="10" Background="{DynamicResource PanelBg}" Padding="16,14,16,14"
            MouseLeftButtonDown="OnShellMouseDown"
            MouseRightButtonUp="OnShellRightClick">

        <Grid>
            <StackPanel x:Name="Modules">

            <!-- 模块：网络速率 -->
            <StackPanel x:Name="SecNetwork">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="&#xE704;" Style="{StaticResource Glyph}"/>
                    <TextBlock Text="网络" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="VpnTag" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Text="" Foreground="{DynamicResource TextTertiary}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,26,0"/>
                </DockPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="DownValue" Text="0" Foreground="{DynamicResource AccentDown}"
                                   FontSize="32" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"/>
                        <TextBlock x:Name="DownUnit" Text="K/s" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" Margin="3,0,0,7" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                Margin="0,0,0,8">
                        <TextBlock Text="↑" Foreground="{DynamicResource AccentUp}" FontSize="12" Margin="0,0,3,0"/>
                        <TextBlock x:Name="UpValue" Text="0" Foreground="{DynamicResource AccentUp}"
                                   FontSize="14" FontFamily="Segoe UI Variable Display"/>
                        <TextBlock x:Name="UpUnit" Text="K/s" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" Margin="2,0,0,1"/>
                    </StackPanel>
                </Grid>

                <Border Height="50" Margin="0,2,0,0" Background="{DynamicResource GraphBg}" CornerRadius="6"
                        ClipToBounds="True">
                    <Canvas x:Name="GraphCanvas"/>
                </Border>
            </StackPanel>

            <!-- 模块：无线网络 -->
            <Border x:Name="SecWlan" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,10"
                    BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}" Tag="nodrag"
                    MouseEnter="OnWlanMouseEnter" MouseLeave="OnWlanMouseLeave"
                    MouseLeftButtonUp="OnWlanClick">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="无线网络" Foreground="{DynamicResource TextTertiary}" FontSize="11"/>
                        <TextBlock x:Name="WlanSignal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    </DockPanel>
                    <TextBlock x:Name="WlanSsid" Text="未连接" Foreground="{DynamicResource TextPrimary}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock x:Name="WlanDetail" Text="" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WlanMore" Text="" Foreground="{DynamicResource TextTertiary}"
                               FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 模块：系统性能 -->
            <Border x:Name="SecPerf" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,10"
                    BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}" Tag="nodrag">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="&#xE9F5;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="系统性能" Foreground="{DynamicResource TextTertiary}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <UniformGrid x:Name="PerfTiles" Columns="4"/>

                    <Border x:Name="PerfDetail" Visibility="Collapsed" Margin="0,0,0,0"
                            Cursor="Hand" MouseLeftButtonUp="OnPerfDetailClick"
                            ToolTip="点击返回四宫格">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="PerfDetailTitle" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="PerfDetailValue" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PerfChartHost" Height="56" Grid.ColumnSpan="2"
                                        Background="{DynamicResource GraphBg}" CornerRadius="6"
                                        ClipToBounds="True">
                                    <Canvas x:Name="PerfCanvas"/>
                                </Border>
                                <StackPanel x:Name="PerfSideList" Grid.Column="1" Width="126"
                                            Margin="8,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="PerfDetailText" FontSize="10" Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 模块：无线设备电量 -->
            <Border x:Name="SecDevices" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,10"
                    BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="&#xE85E;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="无线设备" Foreground="{DynamicResource TextTertiary}" FontSize="11"/>
                    </DockPanel>
                    <StackPanel x:Name="DeviceList"/>
                </StackPanel>
            </Border>

            </StackPanel>

            <!-- 设置按钮：常驻右上角 -->
            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                    Content="&#xE713;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-6,-6,0" ToolTip="设置" Click="OnSettingsClick"/>

        </Grid>
    </Border>
</Window>
